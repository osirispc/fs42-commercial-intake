# FieldStation42 Commercial Intake Config

RAW_DIR="$HOME/Videos/fieldstation42-commercials/raw"
READY_DIR="$HOME/Videos/fieldstation42-commercials/ready"

# Category folders live under READY_DIR by default.
# Example folders created by the menu:
#   $READY_DIR/commercials
#   $READY_DIR/mtv
#   $READY_DIR/90s_commercials
CATEGORY_ROOT_DIR="$READY_DIR"
CATEGORY_LIST="commercials mtv 90s_commercials bumpers trailers station_ids"

MAX_HEIGHT="720"
VIDEO_CRF="23"
AUDIO_BITRATE="128k"

# Set this later once we confirm your real FS42 commercial folder.
FS42_COMMERCIAL_DIR="$HOME/projects/FieldStation42/catalog/stations/twin_peaks/commercials"

# Keep this off so downloads go into your category folders first.
# Set to 1 only when you want scripts to auto-copy everything to FS42.
AUTO_COPY_TO_FS42="0"

# Use this project's yt-dlp, not FieldStation42's venv yt-dlp
YTDLP_BIN="$HOME/projects/fs42-commercial-intake/.venv/bin/yt-dlp"
