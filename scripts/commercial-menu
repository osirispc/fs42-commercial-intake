#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONFIG_FILE="$PROJECT_DIR/config/intake.env"

if [ -f "$CONFIG_FILE" ]; then
  source "$CONFIG_FILE"
else
  RAW_DIR="$HOME/Videos/fieldstation42-commercials/raw"
  READY_DIR="$HOME/Videos/fieldstation42-commercials/ready"
  CATEGORY_ROOT_DIR="$READY_DIR"
  CATEGORY_LIST="commercials mtv 90s_commercials bumpers trailers station_ids"
fi

RAW_DIR="${RAW_DIR:-$HOME/Videos/fieldstation42-commercials/raw}"
READY_DIR="${READY_DIR:-$HOME/Videos/fieldstation42-commercials/ready}"
CATEGORY_ROOT_DIR="${CATEGORY_ROOT_DIR:-$READY_DIR}"
CATEGORY_LIST="${CATEGORY_LIST:-commercials mtv 90s_commercials bumpers trailers station_ids}"
CUTS_DIR="$PROJECT_DIR/cuts"
FS42_DIR="$HOME/projects/FieldStation42"

mkdir -p "$RAW_DIR" "$READY_DIR" "$CATEGORY_ROOT_DIR" "$CUTS_DIR"

pause() {
  echo
  read -r -p "Press Enter to return to menu..."
}

slugify_category() {
  echo "$1" | tr ' ' '_' | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]_-'
}

ensure_category_dirs() {
  local CAT
  for CAT in $CATEGORY_LIST; do
    CAT="$(slugify_category "$CAT")"
    [ -n "$CAT" ] && mkdir -p "$CATEGORY_ROOT_DIR/$CAT"
  done
}

choose_category() {
  ensure_category_dirs

  mapfile -t CATEGORIES < <(find "$CATEGORY_ROOT_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)

  echo >&2
  echo "Choose category folder:" >&2
  echo "---------------------------------------------" >&2

  local OPTIONS=()
  OPTIONS+=("No category / keep in ready")
  for CAT in "${CATEGORIES[@]}"; do
    OPTIONS+=("$CAT")
  done
  OPTIONS+=("Create new category")

  select PICK in "${OPTIONS[@]}"; do
    case "${PICK:-}" in
      "No category / keep in ready")
        printf '%s\n' ""
        return 0
        ;;
      "Create new category")
        local NEW_CAT
        read -r -p "New category name, example 90s_commercials: " NEW_CAT </dev/tty
        NEW_CAT="$(slugify_category "$NEW_CAT")"
        if [ -z "$NEW_CAT" ]; then
          echo "Category cannot be blank." >&2
          continue
        fi
        mkdir -p "$CATEGORY_ROOT_DIR/$NEW_CAT"
        printf '%s\n' "$NEW_CAT"
        return 0
        ;;
      "")
        echo "Invalid selection." >&2
        ;;
      *)
        printf '%s\n' "$PICK"
        return 0
        ;;
    esac
  done
}

choose_file_from_dir() {
  local DIR="$1"
  local LABEL="$2"

  shopt -s nullglob
  local FILES=("$DIR"/*.mp4 "$DIR"/*.mkv "$DIR"/*.webm)

  if [ ${#FILES[@]} -eq 0 ]; then
    echo "No video files found in: $DIR" >&2
    return 1
  fi

  echo >&2
  echo "$LABEL" >&2
  echo "---------------------------------------------" >&2

  select FILE in "${FILES[@]}"; do
    if [ -n "${FILE:-}" ]; then
      printf '%s\n' "$FILE"
      return 0
    fi
    echo "Invalid selection." >&2
  done
}

choose_ready_or_category_file() {
  ensure_category_dirs

  shopt -s nullglob globstar
  local FILES=("$READY_DIR"/*.mp4 "$READY_DIR"/*.mkv "$READY_DIR"/*.webm "$CATEGORY_ROOT_DIR"/*/*.mp4 "$CATEGORY_ROOT_DIR"/*/*.mkv "$CATEGORY_ROOT_DIR"/*/*.webm)

  if [ ${#FILES[@]} -eq 0 ]; then
    echo "No ready/category video files found under: $CATEGORY_ROOT_DIR" >&2
    return 1
  fi

  echo >&2
  echo "Choose ready/category video:" >&2
  echo "---------------------------------------------" >&2

  select FILE in "${FILES[@]}"; do
    if [ -n "${FILE:-}" ]; then
      printf '%s\n' "$FILE"
      return 0
    fi
    echo "Invalid selection." >&2
  done
}

choose_cut_sheet() {
  shopt -s nullglob
  local FILES=("$CUTS_DIR"/*.txt)

  if [ ${#FILES[@]} -eq 0 ]; then
    echo "No cut sheets found in: $CUTS_DIR" >&2
    return 1
  fi

  echo >&2
  echo "Choose cut sheet:" >&2
  echo "---------------------------------------------" >&2

  select FILE in "${FILES[@]}"; do
    if [ -n "${FILE:-}" ]; then
      printf '%s\n' "$FILE"
      return 0
    fi
    echo "Invalid selection." >&2
  done
}

list_categories() {
  ensure_category_dirs
  echo
  echo "Category folders:"
  echo "---------------------------------------------"
  find "$CATEGORY_ROOT_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

move_ready_to_category() {
  READY_FILE="$(choose_file_from_dir "$READY_DIR" "Choose ready video to file into category")" || {
    pause
    return 0
  }

  CATEGORY="$(choose_category)" || {
    pause
    return 0
  }

  if [ -z "$CATEGORY" ]; then
    echo "No category chosen. Leaving file in ready."
    pause
    return 0
  fi

  TARGET_DIR="$CATEGORY_ROOT_DIR/$CATEGORY"
  mkdir -p "$TARGET_DIR"

  echo
  echo "Moving:"
  echo "$READY_FILE"
  echo
  echo "To:"
  echo "$TARGET_DIR/"
  echo

  mv -f "$READY_FILE" "$TARGET_DIR/"
  echo "Done."
  pause
}

list_stations() {
  echo
  echo "Detected FieldStation42 station commercial folders:"
  echo "---------------------------------------------"
  find "$FS42_DIR/catalog" -type d \( -iname "commercial" -o -iname "commercials" \) 2>/dev/null | sort
}

choose_station_folder() {
  mapfile -t STATIONS < <(find "$FS42_DIR/catalog" -type d \( -iname "commercial" -o -iname "commercials" \) 2>/dev/null | sort)

  if [ ${#STATIONS[@]} -eq 0 ]; then
    echo "No station commercial folders found under:" >&2
    echo "$FS42_DIR/catalog" >&2
    return 1
  fi

  echo >&2
  echo "Choose station commercial folder:" >&2
  echo "---------------------------------------------" >&2

  select STATION in "${STATIONS[@]}"; do
    if [ -n "${STATION:-}" ]; then
      printf '%s\n' "$STATION"
      return 0
    fi
    echo "Invalid selection." >&2
  done
}

while true; do
  clear
  ensure_category_dirs

  echo "================================================="
  echo " FIELDSTATION42 COMMERCIAL INTAKE BAY"
  echo "================================================="
  echo
  echo "Project:    $PROJECT_DIR"
  echo "Raw:        $RAW_DIR"
  echo "Ready:      $READY_DIR"
  echo "Categories: $CATEGORY_ROOT_DIR"
  echo "Cuts:       $CUTS_DIR"
  echo
  echo "1) Download one video, then file into category"
  echo "2) Download playlist, then file into category"
  echo "3) List raw downloads"
  echo "4) List ready root"
  echo "5) List category folders"
  echo "6) Move ready video into a category"
  echo "7) Mark cuts for any raw video"
  echo "8) Cut clips from a cut sheet"
  echo "9) Copy ready/category video to a station"
  echo "10) List station commercial folders"
  echo "11) Show Git status"
  echo "0) Exit"
  echo
  read -r -p "Choose an option: " CHOICE

  case "$CHOICE" in
    1)
      echo
      read -r -p "Paste video URL: " URL
      CATEGORY="$(choose_category)"
      if [ -n "$CATEGORY" ]; then
        commercial-one "$URL" "$CATEGORY"
      else
        commercial-one "$URL"
      fi
      pause
      ;;

    2)
      echo
      read -r -p "Paste playlist URL: " URL
      CATEGORY="$(choose_category)"
      if [ -n "$CATEGORY" ]; then
        commercial-playlist "$URL" "$CATEGORY"
      else
        commercial-playlist "$URL"
      fi
      pause
      ;;

    3)
      echo
      echo "Raw downloads:"
      ls -lh "$RAW_DIR" || true
      pause
      ;;

    4)
      echo
      echo "Ready root:"
      ls -lh "$READY_DIR" || true
      pause
      ;;

    5)
      list_categories
      pause
      ;;

    6)
      move_ready_to_category
      ;;

    7)
      RAW_FILE="$(choose_file_from_dir "$RAW_DIR" "Choose raw video to mark")" || {
        pause
        continue
      }

      echo
      read -r -p "Cut sheet name, example sci-fi-commercial-block-01: " CUT_NAME

      if [ -z "$CUT_NAME" ]; then
        BASENAME="$(basename "$RAW_FILE")"
        CUT_NAME="${BASENAME%.*}"
        CUT_NAME="$(echo "$CUT_NAME" | tr ' ' '-' | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]_-')"
      fi

      commercial-mark "$RAW_FILE" "$CUT_NAME" </dev/tty
      pause
      ;;

    8)
      RAW_FILE="$(choose_file_from_dir "$RAW_DIR" "Choose source raw video")" || {
        pause
        continue
      }

      CUT_FILE="$(choose_cut_sheet)" || {
        pause
        continue
      }

      commercial-cut-list "$RAW_FILE" "$CUT_FILE"
      pause
      ;;

    9)
      READY_FILE="$(choose_ready_or_category_file)" || {
        pause
        continue
      }

      TARGET="$(choose_station_folder)" || {
        pause
        continue
      }

      echo
      echo "Copying:"
      echo "$READY_FILE"
      echo
      echo "To:"
      echo "$TARGET/"
      echo

      cp "$READY_FILE" "$TARGET/"
      echo "Done."
      pause
      ;;

    10)
      list_stations
      pause
      ;;

    11)
      echo
      cd "$PROJECT_DIR"
      git status
      echo
      git log --oneline -5
      pause
      ;;

    0)
      echo "Closing commercial intake bay."
      exit 0
      ;;

    *)
      echo "Unknown option: $CHOICE"
      pause
      ;;
  esac
done
