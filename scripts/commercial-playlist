#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CONFIG_FILE="$PROJECT_DIR/config/intake.env"

if [ ! -f "$CONFIG_FILE" ]; then
  echo "Missing config file:"
  echo "$CONFIG_FILE"
  exit 1
fi

source "$CONFIG_FILE"

URL="${1:-}"
CATEGORY="${2:-}"

if [ -z "$URL" ]; then
  echo "Usage:"
  echo "  commercial-playlist 'YOUTUBE_PLAYLIST_URL' [category]"
  exit 1
fi

CATEGORY_ROOT_DIR="${CATEGORY_ROOT_DIR:-$READY_DIR}"
AUTO_COPY_TO_FS42="${AUTO_COPY_TO_FS42:-0}"

mkdir -p "$RAW_DIR" "$READY_DIR" "$CATEGORY_ROOT_DIR"

if [ -n "$CATEGORY" ]; then
  CATEGORY="$(echo "$CATEGORY" | tr ' ' '_' | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]_-')"
  CATEGORY_DIR="$CATEGORY_ROOT_DIR/$CATEGORY"
  mkdir -p "$CATEGORY_DIR"
else
  CATEGORY_DIR="$READY_DIR"
fi

echo "[COMMERCIAL INTAKE] Project: $PROJECT_DIR"
echo "[COMMERCIAL INTAKE] Downloading playlist..."

"${YTDLP_BIN:-yt-dlp}" \
  --yes-playlist \
  -f "bv*[height<=${MAX_HEIGHT}]+ba/b[height<=${MAX_HEIGHT}]" \
  --merge-output-format mp4 \
  -o "$RAW_DIR/%(playlist_index)03d-%(title).80s.%(ext)s" \
  "$URL"

echo "[COMMERCIAL INTAKE] Converting raw files..."

shopt -s nullglob
converted_files=()

for f in "$RAW_DIR"/*.mp4 "$RAW_DIR"/*.webm "$RAW_DIR"/*.mkv; do
  base="$(basename "$f")"
  name="${base%.*}"
  output_file="$READY_DIR/${name}.mp4"

  if [ -f "$output_file" ] || { [ -n "$CATEGORY" ] && [ -f "$CATEGORY_DIR/${name}.mp4" ]; }; then
    echo "Skipping already converted: $name"
    continue
  fi

  echo "Converting: $base"

  ffmpeg -y -i "$f" \
    -vf "scale='min(1280,iw)':-2,fps=30" \
    -c:v libx264 -preset veryfast -crf "$VIDEO_CRF" \
    -c:a aac -b:a "$AUDIO_BITRATE" \
    -movflags +faststart \
    "$output_file"

  if [ -n "$CATEGORY" ]; then
    mv -f "$output_file" "$CATEGORY_DIR/"
    converted_files+=("$CATEGORY_DIR/${name}.mp4")
  else
    converted_files+=("$output_file")
  fi
done

if [ -n "$CATEGORY" ]; then
  echo
  echo "Playlist commercials filed in category:"
  echo "$CATEGORY_DIR"
else
  echo
  echo "Playlist commercials ready in:"
  echo "$READY_DIR"
fi

if [ "$AUTO_COPY_TO_FS42" = "1" ] && [ -n "${FS42_COMMERCIAL_DIR:-}" ] && [ -d "$FS42_COMMERCIAL_DIR" ]; then
  echo
  echo "[COMMERCIAL INTAKE] Copying converted files to FieldStation42..."
  for f in "${converted_files[@]}"; do
    cp "$f" "$FS42_COMMERCIAL_DIR/"
  done
  echo "Copied to: $FS42_COMMERCIAL_DIR"
fi
